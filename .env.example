AIRFLOW_UID=50000
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=change-me
AIRFLOW_FERNET_KEY=replace-with-generated-fernet-key
AIRFLOW_API_JWT_SECRET=replace-with-generated-jwt-secret

# Local OpenLineage file events; true disables collection.
OPENLINEAGE_DISABLED=false

# Install the checksum-verified JAR before enabling the Spark listener.
RETAIL_SPARK_LINEAGE_ENABLED=false
# Optional Java composite transport: file plus the local Marquez service.
RETAIL_SPARK_LINEAGE_MARQUEZ=false
